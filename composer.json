{
    "name": "althinect/filament-spatie-roles-permissions",
    "description": "",
    "keywords": [
        "althinect",
        "filament-spatie-roles-permissions"
    ],
    "homepage": "https://github.com/althinect/filament-spatie-roles-permissions",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Althinect",
            "email": "opensource@althinect",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^4.0|^5.0",
        "illuminate/support": "^9|^10|^11|^12.0|^13.0",
        "spatie/laravel-permission": "^5.4|^6.0|^7.0|^8.0"
    },
    "require-dev": {
        "larastan/larastan": "^2.9||^3.0|dev-l13",
        "laravel/pint": "^1.14",
        "orchestra/testbench": "^10.0.0||^9.0.0||^8.22.0|^11.0",
        "pestphp/pest": "^4.0||^3.0||^2.34",
        "pestphp/pest-plugin-arch": "^4.0||^3.0||^2.7",
        "pestphp/pest-plugin-laravel": "^4.0||^3.0||^2.3",
        "phpstan/extension-installer": "^1.3||^2.0",
        "phpstan/phpstan-deprecation-rules": "^1.1||^2.0",
        "phpstan/phpstan-phpunit": "^1.3||^2.0",
        "spatie/laravel-ray": "^1.35"
    },
    "autoload": {
        "psr-4": {
            "Althinect\\FilamentSpatieRolesPermissions\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests",
            "Althinect\\FilamentSpatieRolesPermissions\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Althinect\\FilamentSpatieRolesPermissions\\FilamentSpatieRolesPermissionsServiceProvider"
            ],
            "aliases": {
                "FilamentSpatieRolesPermissions": "Althinect\\FilamentSpatieRolesPermissions\\FilamentSpatieRolesPermissionsFacade"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
