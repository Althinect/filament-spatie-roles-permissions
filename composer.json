{
    "name": "althinect/filament-spatie-roles-permissions",
    "description": "Filament resources for Spatie roles and permissions with optional tenancy-aware teams support.",
    "keywords": [
        "filament",
        "filament-plugin",
        "roles",
        "permissions",
        "spatie-permission",
        "enum-permission"
    ],
    "homepage": "https://github.com/althinect/filament-spatie-roles-permissions",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Althinect",
            "email": "opensource@althinect.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "filament/filament": "^5.0",
        "spatie/laravel-package-tools": "^1.18",
        "spatie/laravel-permission": "^8.0"
    },
    "suggest": {
        "althinect/enum-permission": "Required only for enum-based permission generation and syncing."
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.21",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Althinect\\FilamentSpatieRolesPermissions\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Althinect\\FilamentSpatieRolesPermissions\\Tests\\": "tests/",
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Althinect\\FilamentSpatieRolesPermissions\\FilamentSpatieRolesPermissionsServiceProvider"
            ],
            "aliases": {
                "FilamentSpatieRolesPermissions": "Althinect\\FilamentSpatieRolesPermissions\\FilamentSpatieRolesPermissionsFacade"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
